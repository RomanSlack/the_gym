# Local-only capture archive (full transcripts; not for a public repo)
.capture/
.claude/settings.local.json

# Blender autosave backups
*.blend1
*.blend2

node_modules/
__pycache__/

# Full-size run previews and renders stay local (small *.thumb.jpg are committed)
terrain/runs/**/*.png
blueprint/public/history/
imagegen-outputs/
*.blend
!reference/gym_v2_original/*.blend
construction/out/

# Equipment list: product photos fetched from shop links (they belong to the shops)
equipment/refs/
equipment/picks.tmp
equipment/replay/out/
equipment/pieces/*/refs/
equipment/.cache/

# third-party reference photos: look, never publish
reference/f4_recovery/

# Over GitHub's 100 MB limit: kept on disk only (PWR Play mega, 386 MB each)
equipment/pieces/life-fitness-pwr-play-mega/models/*.glb

# Viewer feedback captures: the notes (*.json) are kept, the screenshots stay local
feedback/*.png
feedback/trash/
# Materials: reference photos (third-party, not ours) and scratch work stay local; maps + out/ progress renders are committed
materials/*/refs/
materials/*/work/
plants/refs/
plants/work/
